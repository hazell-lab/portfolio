# public address of the site, used for canonical urls, open graph and the sitemap.
# optional: defaults to https://hazimaqil-portfolio.netlify.app
SITE_URL=https://hazimaqil-portfolio.netlify.app

# goatcounter site code, the "name" in name.goatcounter.com. optional: leave it out and
# no page views are counted. set it on netlify, not in a local .env, so local runs are not counted.
# GOATCOUNTER_CODE=
