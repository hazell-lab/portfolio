---
// site header: logo, section links, resume button, theme switch and the mobile menu button.
// on the home page the links jump to sections; on other pages they go back to the home page.
import { ThemeToggle } from '@/components/react/ThemeToggle';
import Icon from '@/components/ui/Icon.astro';
import { navigation, person } from '@/data/site';
import { pad } from '@/lib/projects';

interface Props {
  /** id of the nav item that stays marked as the current page, like "projects" */
  current?: string | undefined;
}

const { current } = Astro.props;
const onHome = Astro.url.pathname === '/';
const hrefFor = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<header class="site-header" id="site-header">
  <div class="container nav-wrapper">
    <a href={onHome ? '#home' : '/'} class="logo">
      <span class="logo-mark" aria-hidden="true">H<em>a</em></span>
      <span class="logo-text">{person.name}</span>
      <!-- extra words for screen readers, the visible name stays at the start of the link name -->
      <span class="visually-hidden">{onHome ? ', back to top' : ', home page'}</span>
    </a>

    <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
      <ul class="nav-list">
        {
          navigation.map((item, index) => (
            <li>
              <a
                class:list={['nav-link', { active: item.id === current }]}
                href={hrefFor(item.id)}
                aria-current={item.id === current ? 'page' : undefined}
                data-section={item.id}
              >
                <span class="nav-num" aria-hidden="true">{pad(index)}</span>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-list-cta">
          <a class="btn btn-primary btn-sm" href={person.resume.href} download={person.resume.fileName}>
            Resume <span class="visually-hidden">(PDF)</span> <Icon name="download" />
          </a>
        </li>
      </ul>
    </nav>

    <div class="nav-tools">
      <!-- a react island, hydrated once the browser is idle so react stays off the critical path.
           the label always names the theme you will switch to -->
      <ThemeToggle client:idle />

      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>
</header>
