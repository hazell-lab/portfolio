---
// one icon from the sprite. decorative by default, so screen readers skip it.
export type IconName =
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'arrow'
  | 'arrow-right'
  | 'arrow-left'
  | 'arrow-down'
  | 'arrow-up'
  | 'download'
  | 'windows'
  | 'expand'
  | 'close';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} aria-hidden="true" focusable="false"><use href={`#i-${name}`}></use></svg>
