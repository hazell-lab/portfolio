---
// a link that opens another site in a new tab.
// noopener and noreferrer stop the new page from reaching back into this one,
// and the hidden text tells screen reader users about the new tab.
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'a'>, 'target' | 'rel'> & { href: string };

const { href, ...rest } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" {...rest}><slot /><span class="visually-hidden"> (opens in a new tab)</span></a>
