---
// renders a data string that may contain **bold** and `code`.
// renderInline escapes all html first, so this is safe to set as html.
import { renderInline } from '@/lib/inline';

interface Props {
  text: string;
  as?: 'p' | 'span' | 'li';
  class?: string;
}

const { text, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class={className} set:html={renderInline(text)} />
