---
// the frame shared by every page: head, icon sprite, skip link, header, footer and scripts
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@/styles/global.css';

import BaseHead from '@/components/layout/BaseHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import IconSprite from '@/components/ui/IconSprite.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** nav item marked as the current page */
  current?: string;
  /** a short name for the page, used by the scripts and styles */
  page: 'home' | 'project' | 'not-found';
}

const { page, current, ...head } = Astro.props;
---

<!doctype html>
<html lang="en-MY">
  <head>
    <BaseHead {...head} />
  </head>
  <body id="top" data-page={page}>
    <IconSprite />
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
